# ==============================================================================
# RIDELINK AWS CONFIGURATION (.env)
# ==============================================================================

# Application Port
PORT=8080

# --- AWS RDS MySQL Database Configuration ---
# Option A: Specify individual RDS connection parameters (Recommended)
DB_HOST=your-rds-endpoint.xxxxxx.region.rds.amazonaws.com
DB_PORT=3306
DB_NAME=rideshare
DB_USERNAME=admin
DB_PASSWORD=your_rds_master_password
DB_USE_SSL=false

# Option B: Or provide the full JDBC connection URL directly
# DB_URL=jdbc:mysql://your-rds-endpoint.xxxxxx.region.rds.amazonaws.com:3306/rideshare?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# --- Security / JWT ---
# Provide a 256-bit+ secure random secret (min 32 characters)
JWT_SECRET=your_long_secure_random_jwt_secret_key_at_least_32_characters

# --- Cloudinary (Media / Profile Image Uploads) ---
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- Geoapify (Maps, Autocomplete & Geocoding) ---
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# --- Chat Encryption (AES-256 GCM) ---
CHAT_ENCRYPTION_KEY=optional_custom_aes_encryption_key_or_defaults_to_jwt_secret
