{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot - RidelinkBackendApplication",
            "request": "launch",
            "cwd": "${workspaceFolder}/backend",
            "mainClass": "com.ridelink.RidelinkBackendApplication",
            "projectName": "backend",
            "args": "",
            "env": {
                "DB_URL": "jdbc:mysql://localhost:3306/rideshare?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true",
                "DB_USERNAME": "root",
                "DB_PASSWORD": "your_db_password_here",
                "JWT_SECRET": "your_jwt_secret_key_here",
                "CLOUDINARY_URL": "cloudinary://your_api_key:your_api_secret@your_cloud_name",
                "GEOAPIFY_API_KEY": "your_geoapify_api_key_here"
            }
        },
        {
            "name": "Launch Frontend (Chrome)",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend"
        }
    ]
}
